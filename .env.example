# RoamWise Backend Environment Variables

# Server Configuration
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Authentication Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=roamwise-dev-secret-change-in-production
SESSION_SECRET=roamwise-family-session-secret-change-in-production

# External Services
OSRM_URL=http://localhost:5000
ORS_URL=https://api.openrouteservice.org
ORS_API_KEY=
OVERPASS_URL=
HAZ_WEATHER_URL=
HAZ_TRAFFIC_URL=
GOOGLE_MAPS_API_KEY=

# Timeout Configuration (milliseconds)
ROUTE_TIMEOUT_MS=12000
HAZ_TIMEOUT_MS=12000

# Cache Configuration
ROUTE_CACHE_MAX=1000
ROUTE_CACHE_TTL_MS=300000
HAZ_CACHE_TTL_MS=600000

# Metrics Configuration
METRICS_WINDOW_MS=600000

# Feature Flags
ROUTE_TEST_HOOKS=0
